{"name": "crlf", "class": ["crlf"], "args": {"paths": ["fixtures/crlf/a.txt"], "old": "a", "new": "c"}, "expect": [1]}
{"name": "no-final-newline", "class": ["no-final-newline"], "args": {"paths": ["fixtures/no-final-newline/a.txt"], "old": "b", "new": "c"}, "expect": [1]}

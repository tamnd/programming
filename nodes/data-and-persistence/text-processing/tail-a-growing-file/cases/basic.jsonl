{"name": "append-lines", "args": {"path": "followed.txt", "initial": "old\n", "steps": ["append:a\nb\n", "poll", "append:c\n", "poll"]}, "expect": [["a", "b"], ["c"]]}
{"name": "rotate", "class": ["rotate"], "args": {"path": "followed.txt", "initial": "1\n", "steps": ["append:2\n", "poll", "rotate", "append:3\n", "poll"]}, "expect": [["2"], ["3"]]}
{"name": "truncate", "class": ["truncate"], "args": {"path": "followed.txt", "initial": "", "steps": ["append:a\nb\n", "poll", "truncate:", "poll", "append:c\n", "poll"]}, "expect": [["a", "b"], [], ["c"]]}

{"name": "object", "class": ["nesting"], "args": {"text": "{\"name\": \"Ada\", \"born\": 1815, \"tags\": [\"math\", \"code\"]}"}, "expect": "{\n  \"born\": 1815,\n  \"name\": \"Ada\",\n  \"tags\": [\n    \"math\",\n    \"code\"\n  ]\n}"}
